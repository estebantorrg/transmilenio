<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup off: the app remembers up to five tu llave numbers on the
         device (`tmgo.cards.v1`), and a card number is all it takes to read that
         card's ledger. They stay on the phone instead of riding along in a
         cloud or adb backup (spec §3.3). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Voice entry point (spec §5.9). Every hands-free surface aims here:
                 the launcher long-press shortcuts below, and anything the rider
                 wires up themselves (a Google Home automation, a home-screen
                 shortcut). "Hey Google, abre TransMi Go" arrives as a plain MAIN
                 launch instead, which the app answers the same way.

                 Deliberately NOT `BROWSABLE`: that category exists so a link in a
                 web page can fire this, and this link opens a live microphone.
                 None of the entry points above need it — a launcher shortcut is an
                 explicit component and an automation's implicit VIEW intent gets
                 DEFAULT — so allowing any page to open the app straight into
                 recording buys nothing and is the one thing worth refusing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="transmigo" android:host="voice" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The app installs its own update (UpdatePlugin, spec §5.2.1b). The first
         lets it hand a downloaded release to the system installer, once the
         rider has allowed this app as an install source; the second lets the
         system skip its confirmation when an app is replacing itself. Android
         still refuses any APK not signed with this app's own key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Webview geolocation ("mi ubicación" on the map) — Capacitor forwards the
         page's geolocation prompt to these Android runtime permissions. The voice
         flow reads the same permission, but only ever the LAST KNOWN fix (spec
         §5.9) — it never starts its own location updates. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Voice question ("¿qué tan cerca está el F19?", spec §5.9). Requested at
         the moment the rider first uses voice, never at boot. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ package visibility: without this the system speech services
         are invisible to us and SpeechRecognizer.isRecognitionAvailable() answers
         false on a device that can perfectly well listen. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
